# Ollama Cloud : renseigner la clé uniquement dans votre copie locale .env.
# API keys : https://ollama.com/settings/keys
OLLAMA_MODE=cloud
OLLAMA_API_KEY=
# Choisir un nom renvoyé par https://ollama.com/api/tags
OLLAMA_MODEL=

# Alternative locale : OLLAMA_MODE=local, clé vide, modèle installé via Ollama.
NLP_ENCODER=camembert
# Autre option : bert
